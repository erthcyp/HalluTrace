        <mxCell id="n6" value="&lt;b&gt;START&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#0E6B57;strokeColor=#0E6B57;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="114" y="244" width="160" height="38" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;Generate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;22 configs × 1,200 × 3 samples&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;≈ 79,000 responses&lt;/font&gt;" style="shape=process;backgroundOutline=1;size=0.04;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="44" y="310" width="300" height="66" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;Decompose into atomic claims&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;the claim is the unit, not the response&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;shared by all three tasks&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="44" y="402" width="300" height="66" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;b&gt;Verify against ground truth&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;Semantic Scholar · PyPI&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;arXiv · gazetteer&lt;/font&gt;" style="shape=process;backgroundOutline=1;size=0.04;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="44" y="494" width="300" height="66" as="geometry"/></mxCell>
        <mxCell id="n10" value="&lt;b&gt;Excluded, or reported apart&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;SUPPORTED · ABSTAINED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;UNVERIFIABLE · PARSE FAILURE&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;policy REFUSAL — tier C only&lt;/font&gt;" style="shape=document;boundedLbl=1;size=0.13;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="372" y="486" width="336" height="96" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;b&gt;AXIS 1 · failure mode&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;EXISTENCE · ATTRIBUTION · NON-ABSTENTION&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;decided from the output alone&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#DFEDE8;strokeColor=#0E6B57;fontColor=#0A5344;" vertex="1" parent="1"><mxGeometry x="44" y="586" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;b&gt;corpus published and indexed?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="82" y="692" width="224" height="104" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;b&gt;n/a — cause not assignable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;tiers B and C · axis 1 only&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=20;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="372" y="714" width="336" height="60" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;AXIS 2 · provenance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;3 query forms × 2 queries per claim&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;→ c_true, c_false&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;TRUTH · ERROR · SILENCE · MIXED · N/A&lt;/font&gt;" style="shape=process;backgroundOutline=1;size=0.04;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#DFEDE8;strokeColor=#0E6B57;fontColor=#0A5344;" vertex="1" parent="1"><mxGeometry x="44" y="820" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;Aggregate per configuration&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;H · A · F · π_k&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;then compare across models&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="44" y="946" width="300" height="66" as="geometry"/></mxCell>
        <mxCell id="n16" value="EXTERNAL SERVICES" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;fillColor=none;strokeColor=#D3DAD4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Consolas;fontSize=10;fontStyle=1;fontColor=#0E6B57;" vertex="1" parent="1"><mxGeometry x="740" y="210" width="244" height="830" as="geometry"/></mxCell>
        <mxCell id="n17" value="&lt;b&gt;Model endpoints&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;vLLM on rented GPU · tier A&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;aggregator B · provider C&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#EBEFEA;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="754" y="310" width="216" height="66" as="geometry"/></mxCell>
        <mxCell id="n18" value="&lt;b&gt;Budget&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;≈ $190 total&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;GPU hours are the&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;uncertain half&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#EBEFEA;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="754" y="402" width="216" height="66" as="geometry"/></mxCell>
        <mxCell id="n19" value="&lt;b&gt;Authoritative indexes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;Semantic Scholar · PyPI&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;arXiv · gazetteer&lt;/font&gt;" style="shape=process;backgroundOutline=1;size=0.04;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#EBEFEA;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="754" y="494" width="216" height="66" as="geometry"/></mxCell>
        <mxCell id="n20" value="&lt;b&gt;Human annotators&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;2 per item · 100 per task&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;consensus is ground truth&lt;/font&gt;" style="shape=trapezoid;perimeter=trapezoidPerimeter;fixedSize=1;size=22;flipV=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#EBEFEA;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="754" y="586" width="216" height="80" as="geometry"/></mxCell>
        <mxCell id="n21" value="&lt;b&gt;Evidence store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;raw counts + matched docs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;kept for every judgment&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=11;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#EBEFEA;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="754" y="690" width="216" height="90" as="geometry"/></mxCell>
        <mxCell id="n22" value="&lt;b&gt;infini-gram API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;n-gram counts over the model's&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;own corpus — not a proxy&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;the mix OLMo 2 actually read&lt;/font&gt;" style="shape=process;backgroundOutline=1;size=0.04;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#EBEFEA;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="754" y="820" width="216" height="100" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;b&gt;Cache and rate limit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;queries keyed on&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;(claim, corpus), not model&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#EBEFEA;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="754" y="946" width="216" height="66" as="geometry"/></mxCell>
        <mxCell id="n24" value="OUTPUT" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;fillColor=none;strokeColor=#D3DAD4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Consolas;fontSize=10;fontStyle=1;fontColor=#0E6B57;" vertex="1" parent="1"><mxGeometry x="16" y="1064" width="968" height="194" as="geometry"/></mxCell>
        <mxCell id="n25" value="&lt;b&gt;Cross-tabulation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;P(cause | mode)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;per configuration&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;Wilson intervals&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;the principal result&lt;/font&gt;" style="shape=document;boundedLbl=1;size=0.13;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#DFEDE8;strokeColor=#0E6B57;fontColor=#0A5344;" vertex="1" parent="1"><mxGeometry x="30" y="1096" width="228" height="140" as="geometry"/></mxCell>
        <mxCell id="n26" value="&lt;b&gt;Scale curve and φ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;π_k over 4 OLMo sizes&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;corpus held fixed&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;φ = the share scaling&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;cannot remove&lt;/font&gt;" style="shape=document;boundedLbl=1;size=0.13;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="266" y="1096" width="228" height="140" as="geometry"/></mxCell>
        <mxCell id="n27" value="&lt;b&gt;Cause-labeled dataset&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;≈ 4,500 instances&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;raw counts and evidence&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;on every judgment&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;released&lt;/font&gt;" style="shape=document;boundedLbl=1;size=0.13;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="502" y="1096" width="228" height="140" as="geometry"/></mxCell>
        <mxCell id="n28" value="&lt;b&gt;Validation report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;P / R / F1 and κ&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;Δ axis independence&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;A_proxy · parse failure&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;abstention kept apart&lt;/font&gt;" style="shape=document;boundedLbl=1;size=0.13;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="738" y="1096" width="228" height="140" as="geometry"/></mxCell>
        <mxCell id="n29" value="&lt;b&gt;END&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#0E6B57;strokeColor=#0E6B57;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="414" y="1300" width="172" height="38" as="geometry"/></mxCell>
        <mxCell id="n30" value="ENVIRONMENT — where all of the above runs" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;fillColor=none;strokeColor=#D3DAD4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Consolas;fontSize=10;fontStyle=1;fontColor=#0E6B57;" vertex="1" parent="1"><mxGeometry x="16" y="1382" width="968" height="202" as="geometry"/></mxCell>
        <mxCell id="n31" value="&lt;b&gt;Compute&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;rented cloud GPU, hourly&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;1x A100 80GB or H100&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;sized for models up to 32B&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;team laptops for the rest&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#EBEFEA;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="30" y="1416" width="180" height="150" as="geometry"/></mxCell>
