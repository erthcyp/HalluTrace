        <mxCell id="n2" value="&lt;b&gt;Prompt set&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;1,200 prompts · 3 tasks&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;citation (primary)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;code packages · should-refuse&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;reused + fresh-authored&lt;/font&gt;" style="shape=manualInput;size=15;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="28" y="52" width="216" height="128" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;Models under test&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;22 configurations&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;A open-data 12&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;B open-weight 7 · C closed 3&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;3 samples per prompt&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=20;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="252" y="52" width="216" height="128" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;Reference corpora&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;olmo-mix-1124 (primary)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;dclm-baseline · pile-train&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;rpj · c4 proxy check&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;tier A only&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=11;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="476" y="52" width="216" height="128" as="geometry"/></mxCell>
