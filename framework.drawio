  <diagram name="HalluTrace framework" id="hallutrace-framework">
    <mxGraphModel dx="1400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="UBUNTU 22.04 LTS · PYTHON 3.11 · CUDA 12.4 · PYTORCH 2.5 · vLLM  —  a single rented cloud GPU, everything inside this boundary runs here" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;fillColor=none;strokeColor=#D3DAD4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Consolas;fontSize=10;fontStyle=1;fontColor=#0E6B57;" vertex="1" parent="1"><mxGeometry x="8" y="8" width="724" height="1486" as="geometry"/></mxCell>
        <mxCell id="n2" value="INPUT" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;fillColor=none;strokeColor=#D3DAD4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Consolas;fontSize=10;fontStyle=1;fontColor=#0E6B57;" vertex="1" parent="1"><mxGeometry x="24" y="58" width="692" height="186" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;Prompt set&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;1,200 prompts · 3 tasks&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;citation (primary)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;code packages · should-refuse&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;reused + fresh-authored&lt;/font&gt;" style="shape=manualInput;size=15;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="34" y="94" width="212" height="128" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;Models under test&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;7 models&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;5 subjects, base, ~7B&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;B open-weight 2 · C closed 2&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;5 samples per prompt&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=20;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="254" y="94" width="212" height="128" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Reference corpora&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;five corpora, one per model&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;dolma-1.7 · dclm · pile&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;rpj-1t · c4 proxy check&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;tier A only&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=11;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="474" y="94" width="212" height="128" as="geometry"/></mxCell>
        <mxCell id="n6" value="PROCESS" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;fillColor=none;strokeColor=#D3DAD4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Consolas;fontSize=10;fontStyle=1;fontColor=#0E6B57;" vertex="1" parent="1"><mxGeometry x="24" y="252" width="692" height="830" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;START&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#0E6B57;strokeColor=#0E6B57;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="116" y="286" width="172" height="38" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;Generate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;5 models × 1,200 × 5 samples&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;30,000 + 6,000 responses&lt;/font&gt;" style="shape=process;backgroundOutline=1;size=0.04;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="52" y="352" width="300" height="66" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;b&gt;Decompose into atomic claims&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;the claim is the unit, not the response&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;shared by all three tasks&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="52" y="444" width="300" height="66" as="geometry"/></mxCell>
        <mxCell id="n10" value="&lt;b&gt;Verify against ground truth&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;Semantic Scholar · PyPI&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;arXiv · gazetteer&lt;/font&gt;" style="shape=process;backgroundOutline=1;size=0.04;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="52" y="536" width="300" height="66" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;b&gt;Excluded, or reported apart&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;SUPPORTED · ABSTAINED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;UNVERIFIABLE · PARSE FAILURE&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;policy REFUSAL — closed only&lt;/font&gt;" style="shape=document;boundedLbl=1;size=0.13;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="380" y="528" width="328" height="92" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;b&gt;AXIS 1 · failure mode&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;EXISTENCE · ATTRIBUTION · NON-ABSTENTION&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;decided from the output alone&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#DFEDE8;strokeColor=#0E6B57;fontColor=#0A5344;" vertex="1" parent="1"><mxGeometry x="52" y="628" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;b&gt;corpus published and indexed?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="90" y="732" width="224" height="104" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;n/a — cause not assignable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;the 2 closed · axis 1 only&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=20;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="380" y="754" width="328" height="60" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;AXIS 2 · provenance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;3 query forms × 2 queries per claim&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;→ c_true, c_false&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;TRUTH · ERROR · SILENCE · MIXED · N/A&lt;/font&gt;" style="shape=process;backgroundOutline=1;size=0.04;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#DFEDE8;strokeColor=#0E6B57;fontColor=#0A5344;" vertex="1" parent="1"><mxGeometry x="52" y="862" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="n16" value="&lt;b&gt;Aggregate per model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;H · A · F · π_k&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;then compare across 5 corpora&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="52" y="988" width="300" height="66" as="geometry"/></mxCell>
        <mxCell id="n17" value="EXTERNAL SERVICES — outside the boundary, someone else runs these" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;fillColor=none;strokeColor=#D3DAD4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Consolas;fontSize=10;fontStyle=1;fontColor=#0E6B57;" vertex="1" parent="1"><mxGeometry x="748" y="252" width="244" height="830" as="geometry"/></mxCell>
        <mxCell id="n18" value="&lt;b&gt;Model endpoints&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;vLLM, self-served · 5&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;provider APIs · 2 closed&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#EBEFEA;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="762" y="352" width="216" height="66" as="geometry"/></mxCell>
        <mxCell id="n19" value="&lt;b&gt;Budget&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;≈ $97 total&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;20 GPU-hours&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;+ $52 illustration row&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#EBEFEA;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="762" y="444" width="216" height="66" as="geometry"/></mxCell>
        <mxCell id="n20" value="&lt;b&gt;Authoritative indexes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;Semantic Scholar · PyPI&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;arXiv · gazetteer&lt;/font&gt;" style="shape=process;backgroundOutline=1;size=0.04;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#EBEFEA;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="762" y="536" width="216" height="66" as="geometry"/></mxCell>
        <mxCell id="n21" value="&lt;b&gt;Human annotators&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;2 per item · 200 per task&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;consensus is ground truth&lt;/font&gt;" style="shape=trapezoid;perimeter=trapezoidPerimeter;fixedSize=1;size=22;flipV=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#EBEFEA;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="762" y="628" width="216" height="80" as="geometry"/></mxCell>
        <mxCell id="n22" value="&lt;b&gt;Evidence store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;raw counts + matched docs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;kept for every judgment&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=11;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#EBEFEA;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="762" y="732" width="216" height="86" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;b&gt;infini-gram API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;n-gram counts over the model's&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;own corpus — never a proxy&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;the mix each model read&lt;/font&gt;" style="shape=process;backgroundOutline=1;size=0.04;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#EBEFEA;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="762" y="862" width="216" height="100" as="geometry"/></mxCell>
        <mxCell id="n24" value="&lt;b&gt;Cache and rate limit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;queries keyed on&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;(claim, corpus), not model&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#EBEFEA;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="762" y="988" width="216" height="66" as="geometry"/></mxCell>
        <mxCell id="n25" value="OUTPUT" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;fillColor=none;strokeColor=#D3DAD4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Consolas;fontSize=10;fontStyle=1;fontColor=#0E6B57;" vertex="1" parent="1"><mxGeometry x="24" y="1106" width="692" height="194" as="geometry"/></mxCell>
        <mxCell id="n26" value="&lt;b&gt;Cross-tabulation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;P(cause | mode)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;per configuration&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;Wilson intervals&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;the principal result&lt;/font&gt;" style="shape=document;boundedLbl=1;size=0.13;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#DFEDE8;strokeColor=#0E6B57;fontColor=#0A5344;" vertex="1" parent="1"><mxGeometry x="34" y="1140" width="162" height="140" as="geometry"/></mxCell>
        <mxCell id="n27" value="&lt;b&gt;Scale curve and φ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;π_k over 4 OLMo sizes&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;corpus held fixed&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;φ = the share scaling&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;cannot remove&lt;/font&gt;" style="shape=document;boundedLbl=1;size=0.13;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="204" y="1140" width="162" height="140" as="geometry"/></mxCell>
        <mxCell id="n28" value="&lt;b&gt;Cause-labeled dataset&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;≈ 3,500 instances&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;raw counts and evidence&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;on every judgment&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;released&lt;/font&gt;" style="shape=document;boundedLbl=1;size=0.13;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="374" y="1140" width="162" height="140" as="geometry"/></mxCell>
        <mxCell id="n29" value="&lt;b&gt;Validation report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;P / R / F1 and κ&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;D label disagreement&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;A_proxy · parse failure&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;abstention kept apart&lt;/font&gt;" style="shape=document;boundedLbl=1;size=0.13;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="544" y="1140" width="162" height="140" as="geometry"/></mxCell>
        <mxCell id="n30" value="&lt;b&gt;END&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#0E6B57;strokeColor=#0E6B57;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="284" y="1326" width="172" height="38" as="geometry"/></mxCell>
        <mxCell id="n31" value="&lt;b&gt;THE STACK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;COMPUTE  a rented cloud GPU, billed by the hour, five models at roughly 7B&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;RUNTIME  Ubuntu 22.04 LTS · Python 3.11 · uv · CUDA 12.4 · PyTorch 2.5&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;SERVING  vLLM · Hugging Face Hub · DuckDB + Parquet · Label Studio&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B776F&quot;&gt;ANALYSIS  pandas · numpy · statsmodels (Wilson CI) · Git, pinned, seeded&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;align=center;verticalAlign=middle;fillColor=#EBEFEA;strokeColor=#D3DAD4;fontColor=#141A17;" vertex="1" parent="1"><mxGeometry x="34" y="1382" width="672" height="100" as="geometry"/></mxCell>
        <mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#D3DAD4;fontFamily=Consolas;fontSize=10;fontColor=#6B776F;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
